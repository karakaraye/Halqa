# Copy to .env.local. Lines starting with # are optional; none of these values is a secret.
# Needs Node 24 or later and one durable server with a writable local disk.

# Path of the SQLite database file. Default: data/halqa.sqlite
HALQA_DB_PATH=data/halqa.sqlite

# Exact public origin of the site, with no trailing slash. Required when hosted: it turns on secure
# cookies and strict transport security, is the only origin accepted on writes, and is the sign-in
# link sent to patients. Set it when running npm run build as well: strict transport security is fixed
# at build time. Leave unset for local development.
# HALQA_ORIGIN=https://your-halqa-host.example

# SHA-256 (hex) of the key the lab system sends to POST /api/intake/results. Store only the hash.
# While a key is being replaced, list up to three hashes separated by commas. Unset: 503.
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "<key>"
# HALQA_INTAKE_KEY_SHA256=

# SHA-256 (hex) of the key the message service sends to POST /api/intake/delivery. Use a different
# key from the intake key. Unset: that route answers 503.
# HALQA_DELIVERY_KEY_SHA256=

# Address the worker posts queued patient messages to. Must be https (plain http only for localhost).
# Unset: messages stay queued and nothing is sent.
# HALQA_MESSAGE_WEBHOOK_URL=https://messages.your-provider.example/send

# Bearer token the worker sends to the message address above. Put the real value only in .env.local.
# HALQA_MESSAGE_WEBHOOK_TOKEN=

# Port the web server listens on (npm run dev and npm start). Default: 3000
# PORT=3000

# Address the web server listens on, for example 127.0.0.1 when the reverse proxy runs on the same
# machine. Default: every address.
# HALQA_LISTEN_HOST=127.0.0.1

# How many reverse proxies in front of the app add the caller's address to X-Forwarded-For (1 to 5).
# Unset or 0: the header is ignored and the connection's own address is used. Set it only when every
# request reaches the app through those proxies; otherwise callers could choose their own address.
# HALQA_TRUST_PROXY=1

# Minutes without any request before a session ends (1 to 480). Sessions always end 8 hours after
# sign-in. Default: 30
# HALQA_SESSION_IDLE_MINUTES=30

# Time zone every screen shows dates and times in, as an IANA name (for example Asia/Dubai). Read when
# the app is built (npm run build). Unset or not valid: each browser's own time zone.
# NEXT_PUBLIC_HALQA_TIME_ZONE=

# Set to production by the hosting service. Switches on production behaviour and always refuses the
# test controls and seed:local.
# NODE_ENV=production

# Lets automated tests move the clock forward and settle messages at once. 1 = on, 0 = off.
# Refused when NODE_ENV is production. Never turn it on for a live service.
HALQA_TEST_CONTROLS=0

# Set to 1 to stop Next.js sending usage reports. The launcher script already sets it.
# NEXT_TELEMETRY_DISABLED=1
